{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ffp-leaderboard.pages.dev/schema/expected-points.schema.json",
  "title": "Expected Points push",
  "description": "What the home machine's ffp run POSTs to /api/expected-points: each priced player's Expected Points and per-Scoring-Stat means for an NFL Week's Games that haven't kicked off, plus the Sleeper-to-ESPN id map for the ESPN projection fallback. Signed as in site/contracts/push-signature.json. Terms as in GLOSSARY.md.",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "season",
    "seasonType",
    "week",
    "players",
    "idMap"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "season": {
      "type": "integer",
      "minimum": 2000
    },
    "week": {
      "type": "integer",
      "minimum": 1,
      "maximum": 23,
      "description": "Regular season 1\u201318 as ESPN numbers them; postseason by round, 1 (Wild Card) to 4 (Super Bowl), whatever ESPN's calendar numbers the Super Bowl week (5 in 2025, after a Pro Bowl week)."
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sleeperId",
          "gsisId",
          "espnId",
          "name",
          "team",
          "position",
          "kickoff",
          "statMeans",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "sleeperId": {
            "type": "string",
            "pattern": "^(\\d+|[A-Z]{2,3})$",
            "description": "Sleeper player id (the team for a D/ST), mapped on the home machine: Sleeper's player list by gsis_id, else nflverse's roster sleeper_id, else a unique name + team match. The Worker never downloads that list (14.7 MB)."
          },
          "gsisId": {
            "type": [
              "string",
              "null"
            ],
            "description": "nflverse gsis_id; null for a D/ST."
          },
          "espnId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d+$",
            "description": "ESPN player id from Sleeper's player list, else nflverse's roster; null if unmapped or a D/ST."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "team": {
            "type": "string",
            "pattern": "^[A-Z]{2,3}$"
          },
          "position": {
            "enum": [
              "QB",
              "RB",
              "WR",
              "TE",
              "K",
              "D/ST"
            ]
          },
          "kickoff": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$",
            "description": "The Game's kickoff. The push only lists players whose Game hasn't kicked off at generatedAt; /api/expected-points keeps an earlier push's entry for a player whose Game has kicked off (frozen at kickoff)."
          },
          "statMeans": {
            "description": "Mean of each Scoring Stat for the whole Game. QB/RB/WR/TE: ffp.scoring's offensive stats. K: pat_made, pat_missed, fg_missed and FGs made by Sleeper's distance buckets (fgm_0_19 \u2026 fgm_60p, as site/contracts/scoring-rules.json sleeperFgBuckets). D/ST: ffp.scoring's D/ST counts plus points_allowed_all, opponent_defensive_tds_points, opponent_return_tds_points and yards_allowed. A missing stat is 0. The Projected Total is current + mean \u00d7 fraction of the Game left, per stat, then scored. Bounded well above any real Game: yards and yards_allowed at 1,000, points_allowed_all and the opponent_*_points at 150, every count at 50.",
            "type": "object",
            "properties": {
              "passing_yards": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "passing_tds": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "passing_interceptions": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "passing_2pt": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "rushing_yards": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "rushing_tds": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "rushing_2pt": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "receptions": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "receiving_yards": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "receiving_tds": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "receiving_2pt": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "fumbles_lost": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "pat_made": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "pat_missed": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "fg_missed": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "fgm_0_19": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "fgm_20_29": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "fgm_30_39": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "fgm_40_49": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "fgm_50_59": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "fgm_60p": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "sacks": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "interceptions": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "fumble_recoveries": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "forced_fumbles": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "safeties": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "blocked_kicks": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "interception_return_tds": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "fumble_return_tds": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "kickoff_return_tds": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "punt_return_tds": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "blocked_kick_return_tds": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "points_allowed_all": {
                "type": "number",
                "minimum": 0,
                "maximum": 150
              },
              "opponent_defensive_tds_points": {
                "type": "number",
                "minimum": 0,
                "maximum": 150
              },
              "opponent_return_tds_points": {
                "type": "number",
                "minimum": 0,
                "maximum": 150
              },
              "yards_allowed": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              }
            },
            "additionalProperties": false
          },
          "expected": {
            "description": "Expected Points (the Score Distribution's mean) by Scoring Rules name; every Leaderboard Scoring Rules option (ppr, half-ppr, standard, espn-league).",
            "type": "object",
            "required": [
              "ppr",
              "half-ppr",
              "standard",
              "espn-league"
            ],
            "additionalProperties": false,
            "properties": {
              "ppr": {
                "type": "number",
                "minimum": -100,
                "maximum": 150
              },
              "half-ppr": {
                "type": "number",
                "minimum": -100,
                "maximum": 150
              },
              "standard": {
                "type": "number",
                "minimum": -100,
                "maximum": 150
              },
              "espn-league": {
                "type": "number",
                "minimum": -100,
                "maximum": 150
              }
            }
          }
        }
      },
      "maxItems": 1500
    },
    "seasonType": {
      "enum": [
        "regular",
        "postseason"
      ]
    },
    "idMap": {
      "description": "Sleeper player id \u2192 ESPN player id, for every QB/RB/WR/TE/K on a team that plays this NFL Week (priced or not), from Sleeper's player list, else nflverse's roster. The Worker joins ESPN's projections to Sleeper ids through it.",
      "type": "object",
      "maxProperties": 3000,
      "propertyNames": {
        "pattern": "^\\d+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^\\d+$"
      }
    }
  }
}
