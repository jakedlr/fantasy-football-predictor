{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ffp-leaderboard.pages.dev/schema/leaderboard.schema.json",
  "title": "Leaderboard",
  "description": "What /api/leaderboard serves: every listed player's Week Points for the current NFL Week, under each Scoring Rules option. Terms as in GLOSSARY.md.",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "week", "expectedPointsAsOf", "scoringRules", "games", "players"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "updatedAt": {"$ref": "#/$defs/instant", "description": "When the Worker last refreshed live stats."},
    "expectedPointsAsOf": {
      "description": "When the latest ffp push was generated; null if none this NFL Week.",
      "oneOf": [{"$ref": "#/$defs/instant"}, {"type": "null"}]
    },
    "week": {
      "type": "object",
      "required": ["season", "seasonType", "number", "start", "end", "firstKickoff", "lastKickoff"],
      "additionalProperties": false,
      "properties": {
        "season": {"type": "integer", "minimum": 2000},
        "seasonType": {"enum": ["regular", "postseason"]},
        "number": {"type": "integer", "minimum": 1, "maximum": 23},
        "start": {"$ref": "#/$defs/instant", "description": "ESPN's week start."},
        "end": {"$ref": "#/$defs/instant", "description": "ESPN's week end."},
        "firstKickoff": {"$ref": "#/$defs/instant"},
        "lastKickoff": {"$ref": "#/$defs/instant"}
      }
    },
    "scoringRules": {
      "description": "The Scoring Rules options, default first; every player's points carry one entry per option.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/rulesName"}
    },
    "games": {"type": "array", "items": {"$ref": "#/$defs/game"}},
    "players": {"type": "array", "items": {"$ref": "#/$defs/player"}}
  },
  "$defs": {
    "instant": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "rulesName": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "team": {"type": "string", "pattern": "^[A-Z]{2,3}$"},
    "points": {"type": "number", "minimum": -100, "maximum": 150},
    "game": {
      "type": "object",
      "required": ["id", "kickoff", "status", "home", "away", "homeScore", "awayScore", "period", "clock"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "description": "ESPN event id."},
        "kickoff": {"$ref": "#/$defs/instant"},
        "status": {"enum": ["upcoming", "live", "final"], "description": "Game Status."},
        "home": {"$ref": "#/$defs/team"},
        "away": {"$ref": "#/$defs/team"},
        "homeScore": {"type": ["integer", "null"]},
        "awayScore": {"type": ["integer", "null"]},
        "period": {"type": ["integer", "null"], "minimum": 1, "description": "Quarter; 5+ is overtime. null unless live."},
        "clock": {"type": ["string", "null"], "pattern": "^\\d{1,2}:\\d{2}$", "description": "Game clock, e.g. 7:32. null unless live."}
      }
    },
    "player": {
      "type": "object",
      "required": ["id", "name", "team", "position", "gameId", "out", "expectedSource", "points"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^(sleeper:\\d+|dst:[A-Z]{2,3})$", "description": "Sleeper player id (the live stats source), or the team for a D/ST."},
        "name": {"type": "string", "minLength": 1},
        "team": {"$ref": "#/$defs/team"},
        "position": {"enum": ["QB", "RB", "WR", "TE", "K", "D/ST"]},
        "gameId": {"type": "string"},
        "out": {"type": "boolean", "description": "Ruled out after the list was built: no Expected Points remain."},
        "expectedSource": {
          "description": "Where Expected Points came from: ffp, ESPN's projection, or none.",
          "enum": ["ffp", "espn", null]
        },
        "points": {
          "type": "object",
          "description": "Keyed by Scoring Rules name; one entry per scoringRules option.",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/rulesName"},
          "additionalProperties": {
            "type": "object",
            "required": ["week", "soFar", "expected"],
            "additionalProperties": false,
            "properties": {
              "week": {"$ref": "#/$defs/points", "description": "Week Points: the ranking number."},
              "soFar": {"oneOf": [{"$ref": "#/$defs/points"}, {"type": "null"}], "description": "Points So Far; null when Upcoming."},
              "expected": {"oneOf": [{"$ref": "#/$defs/points"}, {"type": "null"}], "description": "Expected Points, frozen at kickoff; null when none."}
            }
          }
        }
      }
    }
  }
}
